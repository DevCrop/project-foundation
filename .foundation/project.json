{
  "schemaVersion": 2,
  "project": {
    "name": "project-foundation",
    "runtime": "php"
  },
  "intake": {
    "state": "baseline-ready",
    "observed": [
      "PHP renders HTML",
      "Vite builds SCSS and TypeScript assets",
      "Nginx and PHP-FPM are the default container boundary",
      "Codex is the primary agent"
    ],
    "inferred": [],
    "unverified": [
      "consumer deployment target",
      "consumer page map",
      "consumer integrations",
      "consumer performance budgets"
    ]
  },
  "commands": {
    "install": {"command": "composer", "args": ["install", "--no-interaction"]},
    "assetsInstall": {"command": "npm", "args": ["ci"]},
    "lint": {"command": "composer", "args": ["lint"]},
    "typecheck": {"command": "composer", "args": ["analyse"]},
    "test": {"command": "composer", "args": ["test"]},
    "build": {"command": "npm", "args": ["run", "build"]},
    "start": {"command": "php", "args": ["-S", "127.0.0.1:8080", "-t", "public"]},
    "dependencyValidate": {"command": "composer", "args": ["validate", "--strict", "--no-check-publish"]},
    "dependencyAudit": {"command": "composer", "args": ["audit", "--locked"]},
    "assetAudit": {"command": "npm", "args": ["audit", "--audit-level=moderate"]}
  },
  "pages": {
    "source": "config/pages.php"
  },
  "capabilities": {
    "active": ["publishing", "seo"]
  },
  "assets": {
    "enabled": true,
    "manifest": "public/build/.vite/manifest.json",
    "entries": ["resource/ts/main.ts", "resource/scss/main.scss"]
  },
  "docker": {
    "enabled": true,
    "file": "Dockerfile",
    "service": "php",
    "port": 8080,
    "targets": {
      "development": "php-development",
      "test": "php-test",
      "production": "php-production",
      "web": "nginx-production"
    }
  },
  "github": {
    "visibility": "preserve",
    "defaultBranch": "main"
  },
  "budgets": {
    "productionImageBytes": null,
    "coldBuildMs": null,
    "cachedBuildMs": null,
    "readinessMs": null,
    "frontend": {}
  }
}
