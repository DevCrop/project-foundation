{
  "description": "PHP site starter governed by Project Foundation",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2.33 <8.3",
    "symfony/http-foundation": "^7.4",
    "symfony/routing": "^7.4"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "phpcs --standard=PSR12 bootstrap config public src tests",
    "analyse": "phpstan analyse --level=max bootstrap config public/index.php src tests",
    "test": "phpunit tests"
  },
  "config": {
    "allow-plugins": {},
    "optimize-autoloader": true,
    "platform": {
      "php": "8.2.33"
    },
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
